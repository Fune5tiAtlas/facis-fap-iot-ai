# Copy to env.sh, fill in, `source env.sh` before running the perf scripts.

# --- targets ---
export DSP_BASE_URL="https://<dsp-orce-host>"          # POST $DSP_BASE_URL/dsp/catalogue/request
export AI_BASE_URL="https://<shared-orce-host>"        # GET  $AI_BASE_URL/api/v1/insights/latest
export DSP_AUTH_HEADER=""                              # "Bearer <vp-jwt>" or empty with DSP_IAM_ENFORCE=off

# --- NF-6: AI Insight requires a verified Keycloak token ---
export FACIS_TOKEN=""                                  # access token with realm role ai_insight_consumer

# --- load shape ---
export PERF_VUS=10
export PERF_DURATION=60s

# --- #18 HTTP fetch window (must contain >= 1000 readings) ---
export PERF_ASSET_ID="dataset:facis:net-grid-hourly"
export PERF_WINDOW_FROM="2026-07-01T00:00:00+00:00"
export PERF_WINDOW_TO="2026-07-08T00:00:00+00:00"

# --- #19 Kafka ---
export KAFKA_BOOTSTRAP="<broker1:9093,broker2:9093,broker3:9093>"
export KAFKA_SSL_CA="certs/ca.crt"
export KAFKA_SSL_CERT="certs/tls.crt"
export KAFKA_SSL_KEY="certs/tls.key"
export KAFKA_PERF_TOPIC="perf.throughput.test"

# --- #20/#21/FR-AI-001 Trino ---
export TRINO_HOST="<trino-host>"
export TRINO_PORT=8443
export TRINO_USER="<user>"
export TRINO_PASSWORD="<password>"
export TRINO_HTTP_SCHEME="https"
export TRINO_CATALOG="iceberg"
export TRINO_SCHEMA="gold"
